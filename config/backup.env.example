# Main configuration for btrfs-backup.
# Installed as /etc/btrfs-backup/backup.env with mode 0600.

# Encrypted backup target
BACKUP_MAPPER_NAME={{BACKUP_MAPPER_NAME_SHELL}}
BACKUP_DEVICE={{BACKUP_DEVICE_SHELL}}
BACKUP_LUKS_UUID={{BACKUP_LUKS_UUID_SHELL}}
BACKUP_BTRFS_UUID={{BACKUP_BTRFS_UUID_SHELL}}
BACKUP_MOUNTPOINT={{BACKUP_MOUNTPOINT_SHELL}}
BACKUP_MOUNT_UNIT={{BACKUP_MOUNT_UNIT_SHELL}}
BACKUP_SERVICE_NAME=btrfs-backup.service

# Source definitions and target layout
SOURCES_DIR=/etc/btrfs-backup/sources.d
REMOTE_ROOT={{REMOTE_ROOT_SHELL}}
INCOMING_ROOT={{INCOMING_ROOT_SHELL}}

# Retention. A value of 0 means unlimited.
RETENTION_COUNT={{RETENTION_COUNT}}
LOCAL_RETENTION_COUNT={{LOCAL_RETENTION_COUNT}}

# Runtime policy
DAILY_LIMIT={{DAILY_LIMIT}}
INCREMENTAL_REQUIRED={{INCREMENTAL_REQUIRED}}
KEEP_FAILED_LOCAL_SNAPSHOT={{KEEP_FAILED_LOCAL_SNAPSHOT}}
AUTO_EJECT={{AUTO_EJECT}}
MIN_TARGET_FREE_BYTES={{MIN_TARGET_FREE_BYTES}}
MIN_LOCAL_FREE_BYTES={{MIN_LOCAL_FREE_BYTES}}

# State and locking
LOCK_FILE=/run/btrfs-backup/backup.lock
STATE_DIR=/var/lib/btrfs-backup
EJECT_SCRIPT_PATH={{EJECT_SCRIPT_PATH_SHELL}}

# Notifications: auto, desktop, journal, or none
NOTIFY_ENABLE={{NOTIFY_ENABLE}}
NOTIFY_USER={{NOTIFY_USER_SHELL}}
NOTIFY_METHOD={{NOTIFY_METHOD_SHELL}}
