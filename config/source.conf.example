# Runtime source file generated under /etc/btrfs-backup/profiles/<profile>/sources.d/*.conf
ENABLED=true
SOURCE_NAME={{SOURCE_NAME_SHELL}}
SOURCE_SUBVOLUME={{SOURCE_SUBVOLUME_SHELL}}
LOCAL_SNAPSHOT_DIR={{LOCAL_SNAPSHOT_DIR_SHELL}}
REMOTE_SUBDIR={{REMOTE_SUBDIR_SHELL}}

# Optional per-source overrides. A value of 0 means unlimited.
SOURCE_RETENTION_COUNT={{SOURCE_RETENTION_COUNT}}
SOURCE_LOCAL_RETENTION_COUNT={{SOURCE_LOCAL_RETENTION_COUNT}}
