_btrfs_backup_profile_hint() {
    if [[ -f /etc/btrfs-backup/backup.env && ! -f /etc/btrfs-backup/profiles.d/default.env ]]; then
        cat <<'MSG'
==> Legacy configuration detected:
==>   /etc/btrfs-backup/backup.env
==>
==> Create the default profile from the existing configuration:
==>   sudo btrfs-backup-migrate-profile --profile default
==>
==> After validating the migrated profile, the legacy file can be moved aside:
==>   sudo btrfs-backup-migrate-profile --profile default --force --remove-legacy

MSG
    fi
}

_btrfs_backup_reload_managers() {
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload || true
    fi
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
    fi
}

_btrfs_backup_fix_public_state_permissions() {
    local path

    for path in \
        /var/lib/btrfs-backup \
        /var/lib/btrfs-backup/history \
        /run/btrfs-backup \
        /run/btrfs-backup/profiles; do
        if [[ -d "$path" ]]; then
            chmod 0755 "$path" || true
        fi
    done

    if [[ -d /var/lib/btrfs-backup/history ]]; then
        find /var/lib/btrfs-backup/history -type d -exec chmod 0755 {} + 2>/dev/null || true
        find /var/lib/btrfs-backup/history -type f -name '*.json' -exec chmod 0644 {} + 2>/dev/null || true
    fi
    if [[ -d /run/btrfs-backup/profiles ]]; then
        find /run/btrfs-backup/profiles -type d -exec chmod 0755 {} + 2>/dev/null || true
        find /run/btrfs-backup/profiles -type f -name '*.json' -exec chmod 0644 {} + 2>/dev/null || true
    fi
}

post_install() {
    cat <<'MSG'

==> btrfs-backup was installed.
==> No service was enabled and no active files under /etc were overwritten.
==>
==> Start with:
==>   btrfs-backup-configure --render-only --output-dir ./generated
==>
==> After review, install the active files with:
==>   sudo btrfs-backup-configure --apply
==>
==> Merge the generated crypttab and fstab fragments manually, then run:
==>   sudo systemctl daemon-reload
==>   sudo btrfs-backup --validate

MSG
    _btrfs_backup_reload_managers
    _btrfs_backup_fix_public_state_permissions
    _btrfs_backup_profile_hint
}

post_upgrade() {
    cat <<'MSG'

==> btrfs-backup was upgraded.
==> Existing files under /etc are intentionally not overwritten by the package.
==> Review the changelog and rerun the configurator to migrate generated units:
==>   sudo btrfs-backup-configure --apply

MSG
    _btrfs_backup_reload_managers
    _btrfs_backup_fix_public_state_permissions
    _btrfs_backup_profile_hint
}

pre_remove() {
    cat <<'MSG'

==> Active files under /etc/btrfs-backup, /etc/systemd/system and
==> /etc/udev/rules.d are user configuration and will not be removed.
==> Remove or migrate them manually before uninstalling the package permanently.

MSG
}
