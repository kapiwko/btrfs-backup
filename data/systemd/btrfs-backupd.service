[Unit]
Description=btrfs-backup system manager
Documentation=man:btrfs-backupd(8)

[Service]
Type=dbus
BusName=io.github.btrfsbackup.Manager1
ExecStart=/usr/bin/btrfs-backupd
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=-/var/lib/btrfs-backup/state
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
