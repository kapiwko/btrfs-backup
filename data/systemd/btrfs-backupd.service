[Unit]
Description=btrfs-backup system manager
Documentation=man:btrfs-backupd(8)

[Service]
Type=dbus
BusName=io.github.btrfsbackup.Manager1
ExecStart=@BTRFSBACKUP_MANAGER_EXECUTABLE@
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
RuntimeDirectory=btrfs-backup-manager
RuntimeDirectoryMode=0700
LogsDirectory=btrfs-backup
LogsDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=-/var/lib/btrfs-backup/state
ReadWritePaths=-/run/btrfs-backup-manager
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
