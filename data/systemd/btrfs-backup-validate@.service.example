[Unit]
Description=Validate Btrfs backup target for authorized operation %i
Documentation=file:/usr/share/doc/btrfs-backup/README.md
ConditionPathExists=/etc/btrfs-backup
After=local-fs.target systemd-udevd.service

[Service]
Type=oneshot
EnvironmentFile=/run/btrfs-backup-manager/%i.env
ExecStart={{BACKUP_COMMAND}} --profile ${BTRFS_BACKUP_PROFILE_ID} --validate
User=root
Group=root
UMask=0077
RuntimeDirectory=btrfs-backup
RuntimeDirectoryMode=0755
StateDirectory=btrfs-backup
StateDirectoryMode=0755
Environment=PATH=/usr/bin
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=10min
TimeoutStopSec=90s
KillSignal=SIGINT
KillMode=mixed
SendSIGKILL=yes
SyslogIdentifier=btrfs-backup-validate
