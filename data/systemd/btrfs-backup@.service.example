[Unit]
Description=Verified Btrfs backup profile %i to an encrypted removable target
Documentation=file:/usr/share/doc/btrfs-backup/README.md
ConditionPathExists=/etc/btrfs-backup
After=local-fs.target systemd-udevd.service
StartLimitIntervalSec=5min
StartLimitBurst=3
OnSuccess=btrfs-backup-eject@%i.service
OnFailure=btrfs-backup-eject@%i.service

[Service]
Type=oneshot
ExecStart=@BTRFSBACKUP_BACKUP_COMMAND@ --profile %i
User=root
Group=root
UMask=0077
RuntimeDirectory=btrfs-backup
RuntimeDirectoryMode=0755
StateDirectory=btrfs-backup
StateDirectoryMode=0755
Environment=PATH=/usr/bin
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=infinity
TimeoutStopSec=90s
KillSignal=SIGINT
KillMode=mixed
SendSIGKILL=yes
SyslogIdentifier=btrfs-backup
