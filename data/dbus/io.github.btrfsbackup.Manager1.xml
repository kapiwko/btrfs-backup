      <arg name="profileId" type="s"/>
    </signal>
    <signal name="HistoryChanged">
      <arg name="profileId" type="s"/>
    </signal>
    <signal name="DeviceStateChanged">
      <arg name="profileId" type="s"/>
    </signal>
  </interface>
</node>
