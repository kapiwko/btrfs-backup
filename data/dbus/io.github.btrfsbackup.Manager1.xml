      <arg name="automatic" type="b" direction="in"/>
      <arg name="payload" type="s" direction="out"/>
    </method>
    <method name="GenerateTargetKey">
      <arg name="profileId" type="s" direction="in"/>
      <arg name="authorizationSecret" type="h" direction="in"/>
      <arg name="label" type="s" direction="in"/>
      <arg name="automatic" type="b" direction="in"/>
      <arg name="payload" type="s" direction="out"/>
    </method>
