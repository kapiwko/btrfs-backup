{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io.github.btrfsbackup.profile.schema.json",
  "title": "btrfs-backup profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "name", "enabled", "target", "paths", "settings", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "configurationGeneration": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "profileId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "enabled": { "type": "boolean" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "luksUuid", "btrfsUuid", "mapperName", "activation"],
      "properties": {
        "device": { "type": "string", "pattern": "^/dev(?:/|$)", "maxLength": 4096 },
        "luksUuid": { "$ref": "#/$defs/uuid" },
        "btrfsUuid": { "$ref": "#/$defs/uuid" },
        "partitionUuid": { "$ref": "#/$defs/optionalUuid" },
        "serial": { "type": "string", "pattern": "^(|[A-Za-z0-9][A-Za-z0-9._:+-]{0,255})$" },
        "mapperName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "activation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": { "mode": { "const": "askPassword" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "keyFile"],
              "properties": {
                "mode": { "const": "keyFile" },
                "keyFile": { "$ref": "#/$defs/absolutePath" }
              }
            }
          ]
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remoteRoot", "incomingRoot"],
      "properties": {
        "remoteRoot": { "$ref": "#/$defs/absolutePath" },
        "incomingRoot": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dailyLimit",
        "incrementalRequired",
        "keepFailedLocalSnapshot",
        "autoEject",
        "remoteRetention",
        "localRetention",
        "minimumTargetFreeBytes",
        "minimumLocalFreeBytes"
      ],
      "properties": {
        "dailyLimit": { "type": "boolean" },
        "incrementalRequired": { "type": "boolean" },
        "keepFailedLocalSnapshot": { "type": "boolean" },
        "autoEject": { "type": "boolean" },
        "remoteRetention": { "$ref": "#/$defs/retentionCount" },
        "localRetention": { "$ref": "#/$defs/retentionCount" },
        "minimumTargetFreeBytes": { "$ref": "#/$defs/byteCount" },
        "minimumLocalFreeBytes": { "$ref": "#/$defs/byteCount" }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beforeSnapshot": { "$ref": "#/$defs/hookList" },
        "afterSnapshot": { "$ref": "#/$defs/hookList" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "enabled", "subvolume", "localSnapshotDir", "remoteSubdir"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "enabled": { "type": "boolean" },
          "subvolume": { "$ref": "#/$defs/absolutePath" },
          "localSnapshotDir": { "$ref": "#/$defs/absolutePath" },
          "remoteSubdir": { "$ref": "#/$defs/relativePath" },
          "remoteRetention": { "$ref": "#/$defs/retentionCount" },
          "localRetention": { "$ref": "#/$defs/retentionCount" }
        }
      }
    }
  },
  "$defs": {
    "absolutePath": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "not": { "pattern": "^/|(^|/)\\.\\.?(/|$)" }
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "optionalUuid": {
      "type": "string",
      "pattern": "^(|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})$"
    },
    "hookList": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "program", "arguments", "timeoutSeconds"],
        "properties": {
          "type": { "const": "program" },
          "program": {
            "type": "string",
            "pattern": "^/etc/btrfs-backup/hooks\\.d/[^/]+$",
            "maxLength": 4096
          },
          "arguments": {
            "type": "array",
            "maxItems": 128,
            "items": { "type": "string", "maxLength": 4096 }
          },
          "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
        }
      }
    },
    "retentionCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "byteCount": { "type": "integer", "minimum": 0, "maximum": 1000000000000000 }
  }
}
