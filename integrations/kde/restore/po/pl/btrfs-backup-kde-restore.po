msgid "Restore %1"
msgstr "Przywróć %1"

msgid "Source:"
msgstr "Źródło:"

msgid "Destination:"
msgstr "Miejsce docelowe:"

msgid "Choose destination"
msgstr "Wybierz miejsce docelowe"

msgid "Choose restore destination"
msgstr "Wybierz miejsce przywracania"

msgid "Restore destination"
msgstr "Miejsce przywracania"

msgid "Restore to"
msgstr "Przywróć do"

msgid "Choose…"
msgstr "Wybierz…"

msgid "Type:"
msgstr "Typ:"

msgid "Size:"
msgstr "Rozmiar:"

msgid "Modified:"
msgstr "Zmodyfikowano:"

msgid "Backup date:"
msgstr "Data kopii:"

msgid "File"
msgstr "Plik"

msgid "Folder"
msgstr "Katalog"

msgid "Calculated during restore"
msgstr "Obliczany podczas przywracania"

msgid "File ownership, permissions and timestamps will be preserved and verified."
msgstr "Właściciel, uprawnienia i znaczniki czasu zostaną zachowane i zweryfikowane."

msgid "Cancel"
msgstr "Anuluj"

msgid "Restore"
msgstr "Przywróć"

msgid "The selected backup URL is invalid."
msgstr "Wybrany adres kopii zapasowej jest nieprawidłowy."

msgid "Could not keep the backup browsing session active."
msgstr "Nie udało się utrzymać aktywnej sesji przeglądania kopii zapasowej."

msgid "Restore completed"
msgstr "Przywracanie zakończone"

msgid "Restore failed"
msgstr "Przywracanie nie powiodło się"

msgid "Restored to %1"
msgstr "Przywrócono do %1"

msgid "Restoring backup"
msgstr "Przywracanie kopii zapasowej"

msgid "Source"
msgstr "Źródło"

msgid "Destination"
msgstr "Miejsce docelowe"

msgid "Destination already exists"
msgstr "Miejsce docelowe już istnieje"

msgid "%1 already exists. Replace it transactionally?"
msgstr "%1 już istnieje. Zastąpić je transakcyjnie?"

msgid "Restored one file"
msgid_plural "Restored %1 files"
msgstr[0] "Przywrócono jeden plik"
msgstr[1] "Przywrócono %1 pliki"
msgstr[2] "Przywrócono %1 plików"

msgid "%1 restored to %2"
msgstr "Przywrócono %1 do %2"

msgid "Restoring %1"
msgstr "Przywracanie: %1"

msgid "%1 of %2"
msgstr "%1 z %2"

msgid "%1/s"
msgstr "%1/s"

msgid "Open restored folder"
msgstr "Otwórz przywrócony katalog"

msgid "Show restored file"
msgstr "Pokaż przywrócony plik"

msgid "Close"
msgstr "Zamknij"

msgid "There is not enough free space to restore this backup."
msgstr "W miejscu docelowym nie ma wystarczającej ilości wolnego miejsca."

msgid "Code: %1"
msgstr "Kod: %1"

msgid "Hide technical details"
msgstr "Ukryj szczegóły techniczne"

msgid "Show technical details"
msgstr "Pokaż szczegóły techniczne"

msgid "Technical error details"
msgstr "Szczegóły techniczne błędu"

msgid "The backup data could not be copied to the destination."
msgstr "Nie udało się skopiować danych kopii zapasowej do miejsca docelowego."

msgid "The backup repository could not be found."
msgstr "Nie znaleziono repozytorium kopii zapasowej."

msgid "The restore destination already exists."
msgstr "Miejsce docelowe przywracania już istnieje."

msgid "The restore failed and temporary files could not be fully removed."
msgstr "Przywracanie nie powiodło się i nie udało się całkowicie usunąć plików tymczasowych."

msgid "The restore failed and the previous destination could not be fully recovered."
msgstr "Przywracanie nie powiodło się i nie udało się w pełni odtworzyć poprzedniego miejsca docelowego."

msgid "The restore operation could not be completed."
msgstr "Nie udało się ukończyć przywracania."

msgid "The restore operation was cancelled."
msgstr "Przywracanie zostało anulowane."

msgid "The restored data could not be verified."
msgstr "Nie udało się zweryfikować przywróconych danych."

msgid "The selected backup path is not safe to restore."
msgstr "Wybrana ścieżka kopii zapasowej nie jest bezpieczna do przywrócenia."

msgid "The selected backup repository could not be read."
msgstr "Nie udało się odczytać wybranego repozytorium kopii zapasowej."

msgid "The selected backup version is no longer available."
msgstr "Wybrana wersja kopii zapasowej nie jest już dostępna."

msgid "The selected restore destination is not safe."
msgstr "Wybrane miejsce docelowe przywracania nie jest bezpieczne."

msgid "This backup repository format is not supported."
msgstr "Ten format repozytorium kopii zapasowej nie jest obsługiwany."
