msgstr "Po przygotowaniu"

msgid "Only data on the selected partition will be removed. Other partitions will remain unchanged."
msgstr "Usunięte zostaną tylko dane z wybranej partycji. Pozostałe partycje pozostaną bez zmian."

msgid "A new LUKS2 and Btrfs backup partition will be created in the selected free space. Existing partitions will remain unchanged."
msgstr "W wybranym wolnym miejscu zostanie utworzona nowa partycja kopii zapasowej LUKS2 i Btrfs. Istniejące partycje pozostaną bez zmian."

msgid "All existing partitions on this disk will be removed. The resulting backup target will use LUKS2 encryption and Btrfs."
msgstr "Wszystkie istniejące partycje na tym dysku zostaną usunięte. Utworzony cel kopii zapasowej będzie używać szyfrowania LUKS2 i systemu plików Btrfs."

msgid "Profile identifier"
msgstr "Identyfikator profilu"

msgid "Select source Btrfs subvolume"
msgstr "Wybierz źródłowy podwolumin Btrfs"

msgid "Create a protected key for automatic backups"
msgstr "Utwórz chroniony klucz do automatycznych kopii zapasowych"

msgid "Recovery passphrase"
msgstr "Hasło odzyskiwania"

msgid "Confirm recovery passphrase"
msgstr "Potwierdź hasło odzyskiwania"

msgid "All data on partition %1 will be permanently erased. Other partitions will remain unchanged. Type %2 to confirm."
msgstr "Wszystkie dane na partycji %1 zostaną trwale usunięte. Pozostałe partycje pozostaną bez zmian. Wpisz %2, aby potwierdzić."

msgid "A new partition will be created in the selected free space. Existing partitions will remain unchanged. Type CREATE to confirm."
msgstr "W wybranym wolnym miejscu zostanie utworzona nowa partycja. Istniejące partycje pozostaną bez zmian. Wpisz CREATE, aby potwierdzić."

msgid "All data on %1 will be permanently erased. Type %2 to confirm."
msgstr "Wszystkie dane na %1 zostaną trwale usunięte. Wpisz %2, aby potwierdzić."

msgid "Device preparation failed. The disk may require manual recovery."
msgstr "Przygotowanie urządzenia nie powiodło się. Dysk może wymagać ręcznego odzyskiwania."

msgid "Do not disconnect the device while preparation is in progress."
msgstr "Nie odłączaj urządzenia podczas jego przygotowywania."

msgid "Cancel"
msgstr "Anuluj"

msgctxt "disk size in gibibytes"
msgid "%1 GiB"
msgstr "%1 GiB"

