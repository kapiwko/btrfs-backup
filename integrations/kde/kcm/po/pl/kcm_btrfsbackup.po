msgstr "Urządzenie kopii zapasowej jest gotowe"

msgid "The request is invalid."
msgstr "Żądanie jest nieprawidłowe."

msgid "The selected backup source does not exist."
msgstr "Wybrane źródło kopii zapasowej nie istnieje."

msgid "The selected backup source is not a Btrfs subvolume."
msgstr "Wybrane źródło kopii zapasowej nie jest podwoluminem Btrfs."

msgid "The selected backup source cannot be inspected."
msgstr "Nie można sprawdzić wybranego źródła kopii zapasowej."

msgid "The requested item was not found."
msgstr "Nie znaleziono żądanego elementu."

msgid "The requested item is busy."
msgstr "Żądany element jest zajęty."

msgid "The active backup run has changed. Refresh the page and try again."
msgstr "Aktywne wykonanie kopii zapasowej uległo zmianie. Odśwież stronę i spróbuj ponownie."

msgid "The backup device is disconnected or unavailable."
msgstr "Urządzenie kopii zapasowej jest odłączone lub niedostępne."

msgid "The operation conflicts with the current state. Rescan and try again."
msgstr "Operacja jest sprzeczna z bieżącym stanem. Przeskanuj urządzenia ponownie i spróbuj jeszcze raz."

msgid "The configuration could not be saved."
msgstr "Nie udało się zapisać konfiguracji."

msgid "The operation could not be fully rolled back. Review the system log."
msgstr "Nie udało się całkowicie wycofać operacji. Sprawdź dziennik systemowy."

msgid "The backup manager could not complete the request."
msgstr "Manager kopii zapasowych nie mógł wykonać żądania."

msgid "Refresh the storage layout and select the disk again."
msgstr "Odśwież układ pamięci masowej i ponownie wybierz dysk."

msgid "The passphrases do not match."
msgstr "Hasła nie są takie same."

msgid "Refresh the storage layout and review the preparation plan again."
msgstr "Odśwież układ pamięci masowej i ponownie sprawdź plan przygotowania."

msgid "The backup manager returned an invalid device preparation response."
msgstr "Manager kopii zapasowych zwrócił nieprawidłową odpowiedź dotyczącą przygotowania urządzenia."

msgid "Select a key file between 1 and 4096 bytes and enter a valid passphrase."
msgstr "Wybierz plik klucza o rozmiarze od 1 do 4096 bajtów i wprowadź prawidłowe hasło."

msgid "The backup manager returned an invalid credential response."
msgstr "Manager kopii zapasowych zwrócił nieprawidłową odpowiedź dotyczącą danych uwierzytelniających."

msgid "Choose how the backup device should be configured."
msgstr "Wybierz sposób skonfigurowania urządzenia kopii zapasowej."

msgid "Assign an existing LUKS2 and Btrfs repository. Nothing will be erased."
msgstr "Przypisz istniejące repozytorium LUKS2 i Btrfs. Żadne dane nie zostaną usunięte."

msgid "Create an encrypted target. The selected disk or partition will be modified."
msgstr "Utwórz zaszyfrowany cel. Wybrany dysk lub partycja zostaną zmodyfikowane."

msgid "The existing repository will be verified before it is assigned."
msgstr "Istniejące repozytorium zostanie sprawdzone przed przypisaniem."

msgid "Review the storage plan before any data is changed."
msgstr "Sprawdź plan pamięci masowej przed wprowadzeniem zmian w danych."

msgid "Change setup type"
msgstr "Zmień sposób konfiguracji"

msgid "No suitable backup devices found"
msgstr "Nie znaleziono odpowiednich urządzeń kopii zapasowej"

