[Unit]
Description=Btrfs Backup Plasma progress monitor
PartOf=graphical-session.target
After=plasma-core.target

[Service]
Type=simple
ExecStart=/usr/bin/btrfs-backup-kde-monitor
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
