Name:           btrfs-backup
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Verified Btrfs backups to an encrypted removable target
License:        GPL-3.0-or-later
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  cmake, gcc-c++, nlohmann-json-devel, pkgconfig
BuildRequires:  pkgconfig(blkid), pkgconfig(libcryptsetup), pkgconfig(fdisk)
BuildRequires:  pkgconfig(libmount), pkgconfig(libsystemd), pkgconfig(libudev), pkgconfig(libbtrfsutil)
Requires:       btrfs-progs >= 6.0, coreutils, cryptsetup, polkit, systemd, util-linux

%description
systemd and udev driven Btrfs send/receive backups with LUKS target validation,
interrupted-run recovery, retention, and controlled eject.

%prep
%autosetup

%build
%cmake -DBUILD_KDE_INTEGRATION=OFF -DBUILD_TESTING=OFF -DCMAKE_INSTALL_SYSCONFDIR=/etc
%cmake_build

%install
%cmake_install

%files
%{_bindir}/btrfs-backup*
%dir /etc/btrfs-backup
%dir /etc/btrfs-backup/hooks.d
%{_prefix}/lib/systemd/system/btrfs-backup*.service
%{_datadir}/dbus-1/
%{_datadir}/polkit-1/actions/io.github.btrfsbackup.policy
%{_datadir}/btrfs-backup/
%{_docdir}/btrfs-backup/
