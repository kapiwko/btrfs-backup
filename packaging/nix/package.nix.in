{ lib, stdenv, cmake, pkg-config, nlohmann_json, btrfs-progs, cryptsetup, systemd, util-linux, polkit }:

stdenv.mkDerivation {
  pname = "btrfs-backup";
  version = "@VERSION@";
  src = ./.;
  nativeBuildInputs = [ cmake pkg-config ];
  buildInputs = [ nlohmann_json btrfs-progs cryptsetup systemd util-linux polkit ];
  cmakeFlags = [ "-DBUILD_KDE_INTEGRATION=OFF" "-DBUILD_TESTING=OFF" ];
  meta = {
    description = "Verified Btrfs backups to an encrypted removable target";
    license = lib.licenses.gpl3Plus;
    platforms = lib.platforms.linux;
  };
}
