[Trigger]
Operation = Upgrade
Type = Package
Target = btrfs-backup

[Action]
Description = Checking btrfs-backup profile compatibility
When = PreTransaction
Exec = /usr/bin/btrfs-backupctl upgrade preflight
AbortOnFail
