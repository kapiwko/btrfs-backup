pre_upgrade() {
  local profile profiles_present=false
  for profile in /etc/btrfs-backup/profiles/*/profile.json; do
    if [[ -e $profile || -L $profile ]]; then
      profiles_present=true
      break
    fi
  done
  if [[ $profiles_present == false ]]; then
    return 0
  fi
  if [[ ! -x /usr/bin/btrfs-backupctl ]]; then
    printf '%s\n' 'btrfs-backup: upgrade blocked: installed profiles require the latest 3.2.x migration bridge' >&2
    return 1
  fi
  if ! /usr/bin/btrfs-backupctl upgrade preflight; then
    printf '%s\n' 'btrfs-backup: package upgrade blocked by profile migration preflight' >&2
    printf '%s\n' 'run: btrfs-backupctl profile export-v4 --all --output-dir /root/btrfs-backup-before-4.0' >&2
    return 1
  fi
}
