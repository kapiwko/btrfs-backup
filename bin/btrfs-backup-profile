#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Validate and materialize canonical btrfs-backup JSON profiles."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from typing import Any

SCHEMA_VERSION = 1
PROFILE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
UUID_RE = re.compile(r"^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$")
SERIAL_RE = re.compile(r"^(|[A-Za-z0-9][A-Za-z0-9._:+-]{0,255})$")
FORBIDDEN_MOUNT_POINTS = {"/", "/boot", "/dev", "/etc", "/home", "/proc", "/root", "/run", "/sys", "/usr", "/var"}


class ValidationError(ValueError):
    pass


def fail(message: str, code: int = 2) -> None:
    print(f"btrfs-backup-profile: {message}", file=sys.stderr)
    raise SystemExit(code)


def require_mapping(value: Any, name: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ValidationError(f"{name} must be an object")
    return value


def require_list(value: Any, name: str) -> list[Any]:
    if not isinstance(value, list):
        raise ValidationError(f"{name} must be an array")
    return value


def text(value: Any, name: str, *, allow_empty: bool = False, maximum: int = 512) -> str:
    if not isinstance(value, str):
        raise ValidationError(f"{name} must be text")
    if any(ch in value for ch in ("\x00", "\n", "\r")):
        raise ValidationError(f"{name} contains a forbidden control character")
    if len(value) > maximum:
        raise ValidationError(f"{name} is too long")
    if not allow_empty and not value:
        raise ValidationError(f"{name} must not be empty")
    return value


def identifier(value: Any, name: str) -> str:
    result = text(value, name, maximum=64)
    if not PROFILE_RE.fullmatch(result):
        raise ValidationError(f"{name} contains unsupported characters")
    return result


def absolute_path(value: Any, name: str) -> str:
    result = text(value, name, maximum=4096)
    if not result.startswith("/"):
        raise ValidationError(f"{name} must be an absolute path")
    normalized = os.path.normpath(result)
    if not normalized.startswith("/"):
        raise ValidationError(f"{name} is invalid")
    return normalized


def relative_path(value: Any, name: str) -> str:
    result = text(value, name, maximum=4096)
    path = Path(result)
    if path.is_absolute() or any(part in ("", ".", "..") for part in path.parts):
        raise ValidationError(f"{name} must be a safe relative path")
    return str(path)


def uuid(value: Any, name: str, *, allow_empty: bool = False) -> str:
    result = text(value, name, allow_empty=allow_empty, maximum=64)
    if result == "" and allow_empty:
        return ""
    if not UUID_RE.fullmatch(result):
        raise ValidationError(f"{name} is not a canonical UUID")
    return result.lower()


def boolean(value: Any, name: str, default: bool) -> bool:
    if value is None:
        return default
    if not isinstance(value, bool):
        raise ValidationError(f"{name} must be true or false")
    return value


def integer(value: Any, name: str, default: int, *, minimum: int = 0, maximum: int = 10**15) -> int:
    if value is None:
        return default
    if isinstance(value, bool) or not isinstance(value, int):
        raise ValidationError(f"{name} must be an integer")
    if value < minimum or value > maximum:
        raise ValidationError(f"{name} is outside the supported range")
    return value


def shell_assignment(name: str, value: Any) -> str:
    if isinstance(value, bool):
        rendered = "true" if value else "false"
    else:
        rendered = str(value)
    return f"{name}={shlex.quote(rendered)}\n"


def systemd_mount_unit(mount_point: str) -> str:
    try:
        completed = subprocess.run(
            ["systemd-escape", "-p", "--suffix=mount", mount_point],
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        raise ValidationError(f"cannot derive mount unit for {mount_point}: {exc}") from exc
    return completed.stdout.strip()


def load_json(path: Path) -> Any:
    try:
        with path.open("r", encoding="utf-8") as stream:
            return json.load(stream)
    except (OSError, json.JSONDecodeError, UnicodeDecodeError) as exc:
        raise ValidationError(f"cannot read JSON profile {path}: {exc}") from exc


def normalize_profile(raw: Any) -> dict[str, Any]:
    root = require_mapping(raw, "profile")
    if root.get("schemaVersion") != SCHEMA_VERSION:
        raise ValidationError("schemaVersion must be 1")

    profile_id = identifier(root.get("profileId"), "profileId")
    profile_name = text(root.get("name", profile_id), "name", maximum=160)
    enabled = boolean(root.get("enabled"), "enabled", True)

    target = require_mapping(root.get("target"), "target")
    device = absolute_path(target.get("device"), "target.device")
    if not (device == "/dev" or device.startswith("/dev/")):
        raise ValidationError("target.device must point inside /dev")
    luks_uuid = uuid(target.get("luksUuid"), "target.luksUuid")
    btrfs_uuid = uuid(target.get("btrfsUuid", ""), "target.btrfsUuid", allow_empty=True)
    partition_uuid = uuid(target.get("partitionUuid", ""), "target.partitionUuid", allow_empty=True)
    serial = text(target.get("serial", ""), "target.serial", allow_empty=True, maximum=256)
    if not SERIAL_RE.fullmatch(serial):
        raise ValidationError("target.serial contains unsupported characters")
    mapper_name = identifier(target.get("mapperName"), "target.mapperName")
    mount_point = absolute_path(target.get("mountPoint"), "target.mountPoint")
    if mount_point in FORBIDDEN_MOUNT_POINTS:
        raise ValidationError(f"target.mountPoint is unsafe: {mount_point}")

    paths = require_mapping(root.get("paths", {}), "paths")
    sources_dir = absolute_path(paths.get("sourcesDir", f"/etc/btrfs-backup/profiles/{profile_id}/sources.d"), "paths.sourcesDir")
    remote_root = absolute_path(paths.get("remoteRoot", f"{mount_point}/snapshots"), "paths.remoteRoot")
    incoming_root = absolute_path(paths.get("incomingRoot", f"{mount_point}/.incoming"), "paths.incomingRoot")
    state_dir = absolute_path(paths.get("stateDir", f"/var/lib/btrfs-backup/profiles/{profile_id}"), "paths.stateDir")
    status_root = absolute_path(paths.get("statusRoot", "/run/btrfs-backup/profiles"), "paths.statusRoot")
    history_root = absolute_path(paths.get("historyRoot", "/var/lib/btrfs-backup/history"), "paths.historyRoot")

    if remote_root == incoming_root or remote_root.startswith(incoming_root + "/") or incoming_root.startswith(remote_root + "/"):
        raise ValidationError("paths.remoteRoot and paths.incomingRoot must be separate non-nested paths")

    settings = require_mapping(root.get("settings", {}), "settings")
    notifications = require_mapping(root.get("notifications", {}), "notifications")
    notify_method = text(notifications.get("method", "auto"), "notifications.method")
    if notify_method not in {"auto", "desktop", "journal", "none"}:
        raise ValidationError("notifications.method must be auto, desktop, journal, or none")

    normalized_settings = {
        "dailyLimit": boolean(settings.get("dailyLimit"), "settings.dailyLimit", True),
        "incrementalRequired": boolean(settings.get("incrementalRequired"), "settings.incrementalRequired", True),
        "keepFailedLocalSnapshot": boolean(settings.get("keepFailedLocalSnapshot"), "settings.keepFailedLocalSnapshot", False),
        "autoEject": boolean(settings.get("autoEject"), "settings.autoEject", True),
        "remoteRetention": integer(settings.get("remoteRetention"), "settings.remoteRetention", 30, maximum=100000),
        "localRetention": integer(settings.get("localRetention"), "settings.localRetention", 30, maximum=100000),
        "minimumTargetFreeBytes": integer(settings.get("minimumTargetFreeBytes"), "settings.minimumTargetFreeBytes", 5 * 1024**3),
        "minimumLocalFreeBytes": integer(settings.get("minimumLocalFreeBytes"), "settings.minimumLocalFreeBytes", 1024**3),
    }

    raw_sources = require_list(root.get("sources"), "sources")
    if not raw_sources:
        raise ValidationError("sources must contain at least one source")
    if len(raw_sources) > 128:
        raise ValidationError("at most 128 sources are supported")

    seen_ids: set[str] = set()
    seen_local: set[str] = set()
    seen_remote: set[str] = set()
    sources: list[dict[str, Any]] = []
    for index, item in enumerate(raw_sources):
        source = require_mapping(item, f"sources[{index}]")
        source_id = identifier(source.get("id"), f"sources[{index}].id")
        if source_id in seen_ids:
            raise ValidationError(f"duplicate source id: {source_id}")
        seen_ids.add(source_id)
        local_snapshot_dir = absolute_path(source.get("localSnapshotDir"), f"sources[{index}].localSnapshotDir")
        remote_subdir = relative_path(source.get("remoteSubdir", source_id), f"sources[{index}].remoteSubdir")
        if local_snapshot_dir in seen_local:
            raise ValidationError(f"duplicate localSnapshotDir: {local_snapshot_dir}")
        if remote_subdir in seen_remote:
            raise ValidationError(f"duplicate remoteSubdir: {remote_subdir}")
        seen_local.add(local_snapshot_dir)
        seen_remote.add(remote_subdir)
        sources.append(
            {
                "id": source_id,
                "name": text(source.get("name", source_id), f"sources[{index}].name", maximum=160),
                "enabled": boolean(source.get("enabled"), f"sources[{index}].enabled", True),
                "subvolume": absolute_path(source.get("subvolume"), f"sources[{index}].subvolume"),
                "localSnapshotDir": local_snapshot_dir,
                "remoteSubdir": remote_subdir,
                "remoteRetention": integer(source.get("remoteRetention"), f"sources[{index}].remoteRetention", normalized_settings["remoteRetention"], maximum=100000),
                "localRetention": integer(source.get("localRetention"), f"sources[{index}].localRetention", normalized_settings["localRetention"], maximum=100000),
            }
        )

    if not any(source["enabled"] for source in sources):
        raise ValidationError("at least one source must be enabled")

    return {
        "schemaVersion": SCHEMA_VERSION,
        "profileId": profile_id,
        "name": profile_name,
        "enabled": enabled,
        "target": {
            "device": device,
            "luksUuid": luks_uuid,
            "btrfsUuid": btrfs_uuid,
            "partitionUuid": partition_uuid,
            "serial": serial,
            "mapperName": mapper_name,
            "mountPoint": mount_point,
            "mountUnit": systemd_mount_unit(mount_point),
        },
        "paths": {
            "sourcesDir": sources_dir,
            "remoteRoot": remote_root,
            "incomingRoot": incoming_root,
            "stateDir": state_dir,
            "statusRoot": status_root,
            "historyRoot": history_root,
        },
        "settings": normalized_settings,
        "notifications": {
            "enabled": boolean(notifications.get("enabled"), "notifications.enabled", True),
            "user": text(notifications.get("user", ""), "notifications.user", allow_empty=True, maximum=256),
            "method": notify_method,
        },
        "sources": sources,
    }


def render_profile_env(profile: dict[str, Any]) -> bytes:
    profile_id = profile["profileId"]
    target = profile["target"]
    paths = profile["paths"]
    settings = profile["settings"]
    notifications = profile["notifications"]
    assignments = {
        "PROFILE_ID": profile_id,
        "PROFILE_NAME": profile["name"],
        "BACKUP_MAPPER_NAME": target["mapperName"],
        "BACKUP_DEVICE": target["device"],
        "BACKUP_LUKS_UUID": target["luksUuid"],
        "BACKUP_BTRFS_UUID": target["btrfsUuid"],
        "BACKUP_MOUNTPOINT": target["mountPoint"],
        "BACKUP_MOUNT_UNIT": target["mountUnit"],
        "BACKUP_SERVICE_NAME": f"btrfs-backup@{profile_id}.service",
        "SOURCES_DIR": paths["sourcesDir"],
        "REMOTE_ROOT": paths["remoteRoot"],
        "INCOMING_ROOT": paths["incomingRoot"],
        "RETENTION_COUNT": settings["remoteRetention"],
        "LOCAL_RETENTION_COUNT": settings["localRetention"],
        "DAILY_LIMIT": settings["dailyLimit"],
        "INCREMENTAL_REQUIRED": settings["incrementalRequired"],
        "KEEP_FAILED_LOCAL_SNAPSHOT": settings["keepFailedLocalSnapshot"],
        "AUTO_EJECT": settings["autoEject"],
        "MIN_TARGET_FREE_BYTES": settings["minimumTargetFreeBytes"],
        "MIN_LOCAL_FREE_BYTES": settings["minimumLocalFreeBytes"],
        "LOCK_FILE": f"/run/btrfs-backup/{profile_id}.lock",
        "STATE_DIR": paths["stateDir"],
        "STATUS_ROOT": paths["statusRoot"],
        "HISTORY_ROOT": paths["historyRoot"],
        "EJECT_SCRIPT_PATH": "/usr/lib/btrfs-backup/btrfs-backup-eject.sh",
        "NOTIFY_ENABLE": notifications["enabled"],
        "NOTIFY_USER": notifications["user"],
        "NOTIFY_METHOD": notifications["method"],
    }
    lines = ["# Generated by btrfs-backup-profile. Manual changes may be overwritten.\n"]
    lines.extend(shell_assignment(key, value) for key, value in assignments.items())
    return "".join(lines).encode()


def render_source(source: dict[str, Any]) -> bytes:
    assignments = {
        "ENABLED": source["enabled"],
        "SOURCE_NAME": source["id"],
        "SOURCE_DISPLAY_NAME": source["name"],
        "SOURCE_SUBVOLUME": source["subvolume"],
        "LOCAL_SNAPSHOT_DIR": source["localSnapshotDir"],
        "REMOTE_SUBDIR": source["remoteSubdir"],
        "SOURCE_RETENTION_COUNT": source["remoteRetention"],
        "SOURCE_LOCAL_RETENTION_COUNT": source["localRetention"],
    }
    return ("# Generated by btrfs-backup-profile.\n" + "".join(shell_assignment(key, value) for key, value in assignments.items())).encode()


def render_udev(profile: dict[str, Any]) -> bytes:
    if not profile["enabled"]:
        return b"# Profile disabled; no automatic activation rule.\n"
    target = profile["target"]
    matches = [
        'ACTION=="add"',
        'SUBSYSTEM=="block"',
        'ENV{ID_FS_TYPE}=="crypto_LUKS"',
        f'ENV{{ID_FS_UUID}}=="{target["luksUuid"]}"',
    ]
    if target["partitionUuid"]:
        matches.append(f'ENV{{ID_PART_ENTRY_UUID}}=="{target["partitionUuid"]}"')
    if target["serial"]:
        matches.append(f'ENV{{ID_SERIAL_SHORT}}=="{target["serial"]}"')
    matches.extend(['TAG+="systemd"', f'ENV{{SYSTEMD_WANTS}}+="btrfs-backup@{profile["profileId"]}.service"'])
    return ("# Generated by btrfs-backup-profile.\n" + ", ".join(matches) + "\n").encode()


def atomic_write(path: Path, data: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb", closefd=True) as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        os.chmod(path, mode)
    finally:
        if temporary.exists():
            temporary.unlink()


def render_tree(profile: dict[str, Any], output_dir: Path) -> None:
    profile_id = profile["profileId"]
    root = output_dir / "etc" / "btrfs-backup"
    atomic_write(root / "profiles.d" / f"{profile_id}.env", render_profile_env(profile), 0o600)
    for index, source in enumerate(profile["sources"], start=1):
        atomic_write(root / "profiles" / profile_id / "sources.d" / f"{index * 10:03d}-{source['id']}.conf", render_source(source), 0o600)
    atomic_write(output_dir / "etc" / "udev" / "rules.d" / f"99-btrfs-backup-{profile_id}.rules", render_udev(profile), 0o644)
    public = dict(profile)
    public["generatedAt"] = dt.datetime.now(dt.timezone.utc).isoformat()
    atomic_write(output_dir / "var" / "lib" / "btrfs-backup" / "public" / "profiles" / f"{profile_id}.json", (json.dumps(public, indent=2) + "\n").encode(), 0o644)


def save_tree(profile: dict[str, Any], etc_root: Path, udev_root: Path, public_root: Path) -> None:
    profile_id = profile["profileId"]
    configured_source_root = Path(profile["paths"]["sourcesDir"])
    default_etc_root = Path("/etc/btrfs-backup")
    if configured_source_root == default_etc_root or default_etc_root in configured_source_root.parents:
        source_root = etc_root / configured_source_root.relative_to(default_etc_root)
    else:
        source_root = configured_source_root
    atomic_write(etc_root / "profiles.d" / f"{profile_id}.env", render_profile_env(profile), 0o600)
    if source_root.exists():
        backup = source_root.with_name(f"{source_root.name}.backup-{dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%SZ')}")
        os.replace(source_root, backup)
    for index, source in enumerate(profile["sources"], start=1):
        atomic_write(source_root / f"{index * 10:03d}-{source['id']}.conf", render_source(source), 0o600)
    atomic_write(udev_root / f"99-btrfs-backup-{profile_id}.rules", render_udev(profile), 0o644)
    public = dict(profile)
    public["generatedAt"] = dt.datetime.now(dt.timezone.utc).isoformat()
    atomic_write(public_root / f"{profile_id}.json", (json.dumps(public, indent=2) + "\n").encode(), 0o644)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--etc-root", default=os.environ.get("BTRFS_BACKUP_ETC_ROOT", "/etc/btrfs-backup"))
    parser.add_argument("--udev-root", default=os.environ.get("BTRFS_BACKUP_UDEV_ROOT", "/etc/udev/rules.d"))
    parser.add_argument("--public-root", default=os.environ.get("BTRFS_BACKUP_PUBLIC_ROOT", "/var/lib/btrfs-backup/public/profiles"))
    subparsers = parser.add_subparsers(dest="command", required=True)

    validate_parser = subparsers.add_parser("validate")
    validate_parser.add_argument("--file", required=True)

    render_parser = subparsers.add_parser("render")
    render_parser.add_argument("--file", required=True)
    render_parser.add_argument("--output-dir", required=True)

    save_parser = subparsers.add_parser("save")
    save_parser.add_argument("--file", required=True)

    args = parser.parse_args()
    try:
        profile = normalize_profile(load_json(Path(args.file)))
        if args.command == "validate":
            print(json.dumps(profile, indent=2))
        elif args.command == "render":
            output_dir = Path(args.output_dir).resolve()
            if output_dir in {Path("/"), Path("/etc"), Path("/usr"), Path("/var")}:
                raise ValidationError(f"refusing unsafe output directory: {output_dir}")
            if output_dir.exists():
                shutil.rmtree(output_dir)
            render_tree(profile, output_dir)
            print(f"Rendered profile {profile['profileId']} to {output_dir}")
        elif args.command == "save":
            if os.geteuid() != 0 and Path(args.etc_root) == Path("/etc/btrfs-backup"):
                fail("save to system configuration must be run as root", 1)
            save_tree(profile, Path(args.etc_root), Path(args.udev_root), Path(args.public_root))
            print(f"Saved profile {profile['profileId']}")
    except (ValidationError, OSError) as exc:
        fail(str(exc))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
