#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BUILD_TARGET="$(realpath -m -- "$SCRIPT_DIR/../build/btrfs-backupctl")"
INSTALLED_TARGET="$(realpath -m -- "$SCRIPT_DIR/../lib/btrfs-backup/btrfs-backupctl")"

if [[ -x "$BUILD_TARGET" ]]; then
    exec "$BUILD_TARGET" "$@"
elif [[ -x "$INSTALLED_TARGET" ]]; then
    exec "$INSTALLED_TARGET" "$@"
elif [[ -x /usr/lib/btrfs-backup/btrfs-backupctl ]]; then
    exec /usr/lib/btrfs-backup/btrfs-backupctl "$@"
else
    printf 'Cannot locate btrfs-backupctl.\n' >&2
    exit 1
fi
