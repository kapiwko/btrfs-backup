#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

for candidate in \
    "$SCRIPT_DIR/../build/btrfs-backupctl" \
    "$SCRIPT_DIR/../lib/btrfs-backup/btrfs-backupctl" \
    /usr/lib/btrfs-backup/btrfs-backupctl; do
    if [[ -x "$candidate" ]]; then
        exec "$candidate" target eject "$@"
    fi
done

exec btrfs-backupctl target eject "$@"
