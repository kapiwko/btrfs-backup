#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

for candidate in \
    "$SCRIPT_DIR/../build/btrfs-backup" \
    "$SCRIPT_DIR/../lib/btrfs-backup/btrfs-backup" \
    /usr/lib/btrfs-backup/btrfs-backup; do
    if [[ -x "$candidate" ]]; then
        exec "$candidate" "$@"
    fi
done

printf '%s\n' 'Cannot locate native btrfs-backup.' >&2
exit 1
