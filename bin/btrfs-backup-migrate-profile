#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
INSTALLED_TARGET="$(realpath -m -- "$SCRIPT_DIR/../lib/btrfs-backup/btrfs-backup-migrate-profile.sh")"
SOURCE_TARGET="$(realpath -m -- "$SCRIPT_DIR/../scripts/btrfs-backup-migrate-profile.sh")"

if [[ -x "$INSTALLED_TARGET" ]]; then
    exec "$INSTALLED_TARGET" "$@"
elif [[ -x /usr/lib/btrfs-backup/btrfs-backup-migrate-profile.sh ]]; then
    exec /usr/lib/btrfs-backup/btrfs-backup-migrate-profile.sh "$@"
elif [[ -x "$SOURCE_TARGET" ]]; then
    exec "$SOURCE_TARGET" "$@"
else
    printf 'Cannot locate btrfs-backup-migrate-profile.sh.\n' >&2
    exit 1
fi
